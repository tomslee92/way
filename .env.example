# Way — environment template
# Copy this file to .env.local and fill in real values:  cp .env.example .env.local
#
# Secrets are SERVER-ONLY (no VITE_ prefix). They are read by the serverless
# functions in /api (and the Vite dev middleware) and are never inlined into the
# client bundle. Only the Supabase anon key + URL are exposed client-side, which
# is safe by design. In Vercel, add the server-only keys as "Sensitive".

# --- Supabase (client-safe) -------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- ElevenLabs (Rhema voice) — server-only, read by /api/tts ---------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=uyVNoMrnUku1dZyVEXwD

# --- API.Bible — server-only, read by /api/bible ----------------------------
API_BIBLE_KEY=
